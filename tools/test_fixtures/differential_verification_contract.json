    "magic": "LISB",
    "major_version": 1,
    "encoding": "fixed_width_little_endian",
    "header_length_required": true,
    "flags_required": true,
    "rank_limit": 4,
    "shape_length": 4,
    "global_layer_sentinel": "UINT64_MAX",
    "mode_b_submode_sentinel": "none",
    "source_checkpoint_name_bytes": 96,
    "digest_algorithm_enum": [
      "sha256",
      "none"
    ],
    "payload_digest_algorithm": "sha256",
    "payload_digest_bytes": 32,
    "reserved_extension_bytes_required": true,
    "reserved_forward_compatibility_policy": "must_be_zero_for_v1",
    "required_fields": [
      "magic",
      "major_version",
      "header_length",
      "flags",
      "dtype",
      "phase",
      "rank",
      "shape",
      "element_count",
      "payload_byte_count",
