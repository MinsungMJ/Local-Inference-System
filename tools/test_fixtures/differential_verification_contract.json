      "layer_index",
      "execution_ordinal",
      "mode",
      "mode_b_submode",
      "model_family",
      "canonical_stage",
      "source_checkpoint_name",
      "digest_algorithm",
      "payload_digest",
      "reserved"
    ],
    "validation_rules": [
      "reject_wrong_magic",
      "reject_unsupported_major_version",
      "reject_invalid_header_length",
      "reject_unknown_required_flags",
      "reject_invalid_rank",
      "reject_nonzero_unused_shape_dimensions_where_prohibited",
      "reject_element_count_overflow",
      "reject_payload_byte_count_mismatch",
      "reject_file_length_not_exactly_header_plus_payload",
      "reject_truncated_files",
      "reject_oversized_files",
      "reject_checkpoint_identity_mismatch",
      "reject_dtype_mismatch_across_inputs",
      "reject_shape_mismatch_across_inputs",
      "reject_malformed_string_fields",
      "reject_nonzero_reserved_bytes_for_v1"
    ]
  },
  "secure_temp_file_policy": {
    "threat_model": "local_single_user_mvp",
    "defends_against_compromised_same_uid_producer": false,
    "path_contract": "directory_plus_basename",
    "per_run_directory_created_by": "python_harness",
    "per_run_directory_unpredictable": true,
    "per_run_directory_mode": "0700",
    "directory_type_required": "directory",
    "directory_owner_uid_must_match_current_user": true,
    "reference_candidate_basenames_unpredictable": true,
    "reference_candidate_basenames_distinct": true,
    "producer_receives": [
      "validated_directory",
      "basename"
    ],
    "basename_rejections": [
      "..",
      "absolute_basename",
      "directory_separator",
      "outside_run_directory"
    ],
    "file_creation_mode": "0600",
    "exclusive_creation_required": true,
    "silent_overwrite_allowed": false,
    "nofollow_rule": "use_o_nofollow_where_available_else_private_directory_plus_post_open_checks",
    "validation_never_silently_skipped": true,
    "producer_fstat_required": true,
    "comparator_validations": [
      "regular_file",
      "owner_uid",
      "mode_0600",
      "hard_link_count_one",
      "expected_header",
      "expected_identity",
      "exact_file_length"
    ],
    "streaming_read_required": true,
    "cleanup_on_normal_path": "mandatory",
    "cleanup_on_handled_error_path": "mandatory",
    "cleanup_after_abnormal_termination": "best_effort_only",
    "abnormal_cleanup_not_guaranteed_after": [
      "SIGKILL",
      "host_crash",
      "power_loss",
      "kernel_failure",
      "filesystem_failure"
    ],
    "report_contains_paths": false,
    "report_contains_model_or_input_details_in_cleanup_warnings": false,
    "retention_requires_debug_option": true,
    "retained_debug_distinguished": true,
    "cleanup_failure_warning_reason_code": "temp_cleanup_failed",
    "cleanup_failure_silently_ignored": false,
    "numeric_verdict_remains_valid_if_cleanup_fails_after_comparison": true,
    "stale_run_policy": {
      "default_stale_threshold_hours": 24,
      "destructive_cleanup_default": "explicit_cleanup_command_only",
      "startup_detects_and_warns": true,
      "startup_deletes_by_default": false,
      "metadata_marker_required": true,
      "metadata_marker_fields": [
        "format_version",
        "uid",
        "pid",
        "creation_time",
        "last_heartbeat_time",
        "debug_retain"
      ],
      "active_run_protection": [
        "lock",
        "heartbeat"
      ],
      "validate_owner_and_mode_before_deletion": true,
      "retained_debug_directories_skipped": true,
      "audit_summary_for_deleted_or_skipped": true,
      "warnings_use_safe_run_identifiers_only": true
    }
  },
