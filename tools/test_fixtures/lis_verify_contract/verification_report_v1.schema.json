{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lis:verification-report:v1",
  "x-lis-schema": "lis.verification_report/v1",
  "title": "LIS Verify canonical verification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "report_version",
    "attempt",
    "command",
    "verdict",
    "reason_codes",
    "policy_result",
    "identities",
    "token_comparison",
    "localization",
    "coverage",
    "numeric_confirmation",
    "evidence",
    "stages",
    "next_action",
    "warnings",
    "cleanup"
  ],
  "properties": {
    "schema": {"const": "lis.verification_report/v1"},
    "kind": {"const": "verification_report"},
    "report_version": {"const": "1.0"},
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workflow_classification"],
      "properties": {
        "id": {"type": "string", "pattern": "^lisa1:[0-9a-f]{32}$", "maxLength": 38},
        "workflow_classification": {"enum": ["development_debugging", "verification_acceptance"]}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "require_supported", "output_path_redacted"],
      "properties": {
        "mode": {"enum": ["demo", "backend", "runtime"]},
        "require_supported": {"type": "boolean"},
        "output_path_redacted": {"const": true}
      }
    },
    "verdict": {"enum": ["PASS", "REGRESSION", "INCONCLUSIVE", "UNSUPPORTED", "HARNESS_ERROR"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128, "x-lis-maxUtf8Bytes": 128}
    },
    "policy_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "satisfied", "exit_code", "reason"],
      "properties": {
        "policy": {"enum": ["default", "require_supported"]},
        "satisfied": {"type": "boolean"},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "reason": {"type": "string", "minLength": 1, "maxLength": 256, "x-lis-maxUtf8Bytes": 256}
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "candidate"],
      "properties": {
        "reference": {"$ref": "#/$defs/sourceIdentity"},
        "candidate": {"$ref": "#/$defs/sourceIdentity"}
      }
    },
    "token_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference_observed_count", "candidate_observed_count", "first_mismatch"],
      "properties": {
        "status": {"enum": ["equal", "mismatch", "unavailable"]},
        "reference_observed_count": {"type": "integer", "minimum": 0},
        "candidate_observed_count": {"type": "integer", "minimum": 0},
        "first_mismatch": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/tokenMismatch"}
          ]
        }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_suspect_interval", "intra_layer_suspect_interval"],
      "properties": {
        "layer_suspect_interval": {"type": ["string", "null"], "maxLength": 256, "x-lis-maxUtf8Bytes": 256},
        "intra_layer_suspect_interval": {"type": ["string", "null"], "maxLength": 256, "x-lis-maxUtf8Bytes": 256}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "common_layers",
        "missing_reference_layers",
        "missing_candidate_layers",
        "common_intra_layer_stages",
        "missing_reference_intra_layer_stages",
        "missing_candidate_intra_layer_stages"
      ],
      "properties": {
        "scope": {"type": "string", "minLength": 1, "maxLength": 128, "x-lis-maxUtf8Bytes": 128},
        "common_layers": {"$ref": "#/$defs/layerCollection"},
        "missing_reference_layers": {"$ref": "#/$defs/layerCollection"},
        "missing_candidate_layers": {"$ref": "#/$defs/layerCollection"},
        "common_intra_layer_stages": {"$ref": "#/$defs/stageCollection"},
        "missing_reference_intra_layer_stages": {"$ref": "#/$defs/stageCollection"},
        "missing_candidate_intra_layer_stages": {"$ref": "#/$defs/stageCollection"}
      }
    },
    "numeric_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confirmed_divergence_at_checkpoint", "confirmed_first_divergence"],
      "properties": {
        "status": {"enum": ["not_performed", "incomplete"]},
        "confirmed_divergence_at_checkpoint": {"type": "null"},
        "confirmed_first_divergence": {"type": "null"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "ceiling", "nonclaims"],
      "properties": {
        "tier": {"type": "string", "minLength": 1, "maxLength": 128, "x-lis-maxUtf8Bytes": 128},
        "ceiling": {"type": "string", "minLength": 1, "maxLength": 128, "x-lis-maxUtf8Bytes": 128},
        "nonclaims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tensor_equality", "numeric_divergence_confirmed", "first_divergence_confirmed", "whole_runtime_equivalence"],
          "properties": {
            "tensor_equality": {"const": false},
            "numeric_divergence_confirmed": {"const": false},
            "first_divergence_confirmed": {"const": false},
            "whole_runtime_equivalence": {"const": false}
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/stageResult"}
    },
    "next_action": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/nextAction"}
      ]
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256, "x-lis-maxUtf8Bytes": 256}
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "residue_status", "observed", "retained_debug"],
      "properties": {
        "status": {"enum": ["success", "failed", "partial", "retained_debug", "not_applicable"]},
        "residue_status": {"enum": ["none_observed", "present", "unknown", "retained_debug"]},
        "observed": {"type": "boolean"},
        "retained_debug": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71, "x-lis-maxUtf8Bytes": 71},
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "binary_sha256", "model_sha256", "config_sha256", "input_sha256", "runtime_sha256", "backend_sha256"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_sha256": {"$ref": "#/$defs/sha256"},
        "backend_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tokenMismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_token_step", "reference_token_id", "candidate_token_id"],
      "properties": {
        "generated_token_step": {"type": "integer", "minimum": 0},
        "reference_token_id": {"type": "integer", "minimum": 0},
        "candidate_token_id": {"type": "integer", "minimum": 0}
      }
    },
    "layerCollection": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 4095}
    },
    "stageCollection": {
      "type": "array",
      "maxItems": 17,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128, "x-lis-maxUtf8Bytes": 128}
    },
    "stageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "result_ref", "evidence_tier", "failure_class", "reason", "blocker"],
      "properties": {
        "name": {"enum": ["preflight", "reference_original_execution", "candidate_original_execution", "pass0_calibration", "pass1_token_localization", "pass2_prefix_policy_reproduction", "pass3a_discovery", "bounded_recapture", "pass3b_authoritative_localization", "pass4_intra_layer_localization", "aggregation", "cleanup"]},
        "state": {"enum": ["executed", "not_applicable", "blocked", "failed"]},
        "result_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "evidence_tier": {"type": ["string", "null"], "maxLength": 128, "x-lis-maxUtf8Bytes": 128},
        "failure_class": {"type": ["string", "null"], "maxLength": 128, "x-lis-maxUtf8Bytes": 128},
        "reason": {"type": ["string", "null"], "maxLength": 256, "x-lis-maxUtf8Bytes": 256},
        "blocker": {"type": ["string", "null"], "maxLength": 128, "x-lis-maxUtf8Bytes": 128}
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128, "x-lis-maxUtf8Bytes": 128},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512, "x-lis-maxUtf8Bytes": 512}
      }
    }
  }
}
